## ─── Required ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB — use Atlas URI for production
# Local:   mongodb://localhost:27017/healthai
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/healthai?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/healthai

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_EXPIRES_IN=7d

# Frontend origin for CORS
# Dev:  http://localhost:5173
# Prod: https://www.healthcocreate.com
CLIENT_ORIGIN=http://localhost:5173

# Optional second CORS origin (e.g. another team member's Vercel deployment)
# CLIENT_ORIGIN_EXTRA=https://healthai-co-creation-platform-xxx.vercel.app

# FRONT-END url. Used for links inside emails (verify, reset-password).
# Prod: https://www.healthcocreate.com
APP_BASE_URL=http://localhost:5173

# THIS SERVER's own public url. Used to build OAuth callback urls, which the
# provider redirects back to — so it must point at the API, not the front end.
# Prod: https://your-service.onrender.com
SERVER_BASE_URL=http://localhost:5000

## ─── Cloudflare Turnstile ──────────────────────────────────────────────────
# Dev test secret (always passes): 1x0000000000000000000000000000000AA
# Get your real secret key at: https://dash.cloudflare.com/turnstile
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

## ─── Email / SMTP ──────────────────────────────────────────────────────────
# If unset, emails are printed to the console instead of being sent.
# Gmail example (requires an App Password, not your login password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your.email@gmail.com
#   SMTP_PASS=xxxx_xxxx_xxxx_xxxx   ← 16-char App Password
#   SMTP_FROM="HEALTH AI" <noreply@your-domain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HEALTH AI" <noreply@healthai.local>

## ─── AI (Google Gemini) ────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Two ways this breaks every AI feature at once (matching, AI Assist,
# translation, meeting summaries), and they pull in opposite directions:
#
#   404 — a pinned model id that Google has since retired. This is what took
#         the AI down once already, with GEMINI_MODEL=gemini-2.0-flash.
#   503 — the model is up but saturated. The "-latest" aliases attract the
#         most traffic and are the first to shed load; measured 1 success in
#         4 on gemini-flash-latest while gemini-3.6-flash returned 4 of 4.
#
# So pin a current id here and re-check it now and then; the code default
# stays on the alias, which cannot 404 even if this value goes stale.
# Verify a candidate before trusting it:
#   curl -s -o /dev/null -w '%{http_code}\n' -X POST \
#     "https://generativelanguage.googleapis.com/v1beta/models/<id>:generateContent?key=$GEMINI_API_KEY" \
#     -H 'Content-Type: application/json' -d '{"contents":[{"parts":[{"text":"ok"}]}]}'
GEMINI_MODEL=gemini-3.6-flash

## ─── OAuth (optional) ──────────────────────────────────────────────────────
# Used only to LINK a provider to an already-signed-in account from the profile
# page. Sign-up and sign-in are never done through OAuth, so that registration
# stays behind the institutional .edu / .gov check.
# Leave a pair blank and that provider's tile reports itself as unavailable.

# GitHub OAuth — https://github.com/settings/applications/new
# Authorization callback URL: <SERVER_BASE_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn — https://www.linkedin.com/developers/apps
# Needs the "Sign In with LinkedIn using OpenID Connect" product (scopes
# openid, profile). The older r_liteprofile / r_emailaddress scopes are retired.
# Redirect URL: <SERVER_BASE_URL>/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
