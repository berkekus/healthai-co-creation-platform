## ─── Required ─────────────────────────────────────────────────────────────────
# Backend API base URL (no trailing slash)
# Dev:    http://localhost:5000/api
# Prod:   https://your-railway-backend.up.railway.app/api
#         OR /api  (if frontend+backend served from the same domain via nginx)
VITE_API_URL=http://localhost:5000/api

## ─── Cloudflare Turnstile ──────────────────────────────────────────────────
# Dev test site key (always passes): 1x00000000000000000000AA
# Get your real site key at: https://dash.cloudflare.com/turnstile
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

## ─── AI (Google Gemini) ────────────────────────────────────────────────────
# The Gemini key is used by the BACKEND only (via /api/ai/*).
# Set GEMINI_API_KEY in your Railway/backend environment — NOT here.
# VITE_GEMINI_API_KEY is intentionally absent from the frontend.
