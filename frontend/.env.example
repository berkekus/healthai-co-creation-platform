## ─── Required ─────────────────────────────────────────────────────────────────
# Backend API base URL (no trailing slash)
# Dev:    http://localhost:5000/api
# Prod:   https://your-railway-backend.up.railway.app/api
#         OR /api  (if frontend+backend served from the same domain via nginx)
VITE_API_URL=http://localhost:5000/api

## ─── Cloudflare Turnstile ──────────────────────────────────────────────────
# Dev test site key (always passes): 1x00000000000000000000AA
# Get your real site key at: https://dash.cloudflare.com/turnstile
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

## ─── AI (Google Gemini) ────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
# Note: this key is embedded in the browser bundle — use a restricted key in prod
VITE_GEMINI_API_KEY=your_gemini_key_here
